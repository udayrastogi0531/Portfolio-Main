# ==============================================================================
# 🌌 Uday Prakash Rastogi — Cinematic AI Portfolio
#     Production Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' in the root directory.
# 2. Fill in the values for each section below.
# 3. DO NOT commit '.env.local' or any actual values to version control.
# ==============================================================================

# ─── AI PROVIDERS (REQUIRED FOR CHAT ASSISTANT) ───────────────────────────────
# At least one cloud LLM API key must be provided. The portfolio AI engine (ARIA)
# automatically falls back through Groq -> Gemini -> OpenRouter -> Local Mock.

# Groq API Key (Primary AI provider for ultra-low latency Llama-3 responses)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_goes_here

# Google Gemini API Key (Secondary fallback provider for Gemini-2.5-flash)
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_goes_here

# OpenRouter API Key (Tertiary fallback provider for cost-effective cloud endpoints)
# Get your key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_goes_here

# Together AI Key (Optional fallback provider for Together Llama models)
# Get your key at: https://api.together.xyz
TOGETHER_API_KEY=

# HuggingFace API Key (Optional fallback provider for Hugging Face Inference API)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=


# ─── SUPABASE DATABASE & INTEGRATIONS (REQUIRED) ──────────────────────────────
# Used to persist analytics, chat logs, recruiter telemetry, and contact forms.
# Read/write policies are secured via Row Level Security (RLS) policies.

# Supabase Project URL (From Project Settings -> API)
# Get your url at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable API Key (Safe to expose client-side with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ─── EMAIL TRANSMISSION SERVICES ──────────────────────────────────────────────
# Handles contact form notifications. Sends copy email using custom templates.

# Resend API Key (Transactional Email API provider)
# Get your key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_goes_here

# Destination Email (Where contact form submissions are routed)
EMAIL_TO=udayprakashrastogi2005@gmail.com


# ─── VOICE INTRODUCTION SYSTEM ────────────────────────────────────────────────
# Powers ElevenLabs text-to-speech for ARIA's voice greeting.

# ElevenLabs API Key (Free tier voice generation)
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_goes_here


# ─── CORE APP VARIABLES ───────────────────────────────────────────────────────

# Next.js Server URL (Matches localhost in dev, or your production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Username (Used to pull live repository metadata and heatmaps)
NEXT_PUBLIC_GITHUB_USERNAME=udayrastogi0531


# ─── OPTIONAL / ENTERPRISE SERVICES ──────────────────────────────────────────

# Google Analytics ID (e.g. G-XXXXXXX)
GOOGLE_ANALYTICS_ID=

# Sentry DSN (Application error tracking and performance profiling)
SENTRY_DSN=
