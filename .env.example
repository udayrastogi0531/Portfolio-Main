# Environment Variables — Uday's Cinematic AI Portfolio

# ============================================================
# OPENAI — Required for AI Chat, Resume Analyzer, Recommender
# Get your key at: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# AI FEATURES — Fallback mode (set to "true" to use mocks)
# ============================================================
NEXT_PUBLIC_AI_MOCK_MODE=true

# ============================================================
# DATABASE — MongoDB (optional, for contact form persistence)
# Get free cluster at: https://mongodb.com/atlas
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# ============================================================
# EMAIL — For contact form (using Gmail SMTP)
# Create an App Password at: https://myaccount.google.com/apppasswords
# ============================================================
EMAIL_FROM=uday@example.com
EMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_TO=uday@example.com

# ============================================================
# GITHUB — For GitHub analytics section
# Create a token at: https://github.com/settings/tokens
# ============================================================
GITHUB_TOKEN=ghp_your-github-personal-access-token
NEXT_PUBLIC_GITHUB_USERNAME=udaykumar

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Uday Kumar — Portfolio"
NODE_ENV=development
