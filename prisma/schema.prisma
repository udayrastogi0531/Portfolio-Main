// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contacts")
}

model PageView {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  page      String
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@map("page_views")
}
